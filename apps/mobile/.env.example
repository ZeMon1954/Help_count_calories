# Public values are embedded in the app bundle. Never put server secrets here.
# Physical iPhone: use the development computer's reachable LAN IP or a secure tunnel.
EXPO_PUBLIC_API_URL=http://192.168.1.108:3000/api
EXPO_PUBLIC_SUPABASE_URL=
# Use a current Supabase publishable key; legacy anon keys also work.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
