# Public values are embedded in the app bundle. Never put server secrets here.
# Vercel PWA: use the public HTTPS API URL. Local native development can use a reachable LAN IP.
EXPO_PUBLIC_API_URL=https://nub-cal-api.onrender.com/api
EXPO_PUBLIC_SUPABASE_URL=
# Use a current Supabase publishable key; legacy anon keys also work.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
