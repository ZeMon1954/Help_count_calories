{
  "expo": {
    "name": "นับแคล",
    "slug": "ai-fitness-calorie-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aifitness",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "อนุญาตให้นับแคลใช้ตำแหน่งเพื่อบันทึกระยะทางและเส้นทางระหว่างกิจกรรม",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "อนุญาตให้นับแคลเลือกรูปอาหารเพื่อวิเคราะห์โภชนาการ",
          "cameraPermission": "อนุญาตให้นับแคลถ่ายรูปอาหารเพื่อวิเคราะห์โภชนาการ"
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "web": {
      "name": "นับแคล",
      "shortName": "นับแคล",
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icon-192.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.aifitness"
    },
    "android": { "package": "com.example.aifitness" }
  }
}
