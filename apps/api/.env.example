PORT=3000
HOST=0.0.0.0
SUPABASE_URL=
# Prefer a current Supabase publishable key. Legacy anon keys remain supported.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Create this key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Existing local installations using AI_API_KEY remain supported, but new setups
# should use GEMINI_API_KEY.
# Stable multimodal model; change only after checking current Gemini model docs.
GEMINI_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=30000
